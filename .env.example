# 로컬 실행용. 실제 값은 GitHub Secrets / Vercel 환경변수에만 넣고, 이 파일은 예시로만 둔다.
# 공공데이터포털 키는 '디코딩된' 값(%2F, %3D 가 없는 형태)을 넣는다. 인코딩된 키를 넣어도 pipeline이 디코딩한다.
NCPMS_API_KEY=
DATA_GO_KR_KEY=
NONGSARO_API_KEY=       # 농사로 OpenAPI(주간농사정보·작목별 농업기술정보)
NONGSARO_WORKPLAN_KEY=  # 농사로 농작업일정(farmWorkingPlanNew) — 농사로는 서비스 신청마다 키가 따로 나온다
KMA_API_KEY=            # 비우면 DATA_GO_KR_KEY 로 기상청 단기예보를 호출
CRON_SECRET=            # Vercel /api/cron/refresh·/api/cron/notify 호출 보호용(임의의 긴 문자열). GitHub Secrets 에도 같은 값
SITE_URL=               # 배포 주소(예: https://pest-forecast.vercel.app) — GitHub Variables 에도 넣어 배치 뒤 알림 발송에 쓴다
# 내 농장 위험도 알림(Web Push) — apps/web/lib/push.ts. 셋 다 있어야 켜진다
KV_REST_API_URL=        # Upstash Redis REST 주소(Vercel Marketplace 에서 연결하면 자동 등록, UPSTASH_REDIS_REST_URL 도 됨)
KV_REST_API_TOKEN=      # Upstash Redis REST 토큰
VAPID_PUBLIC_KEY=       # `npx web-push generate-vapid-keys` 로 한 번 생성(공개키는 브라우저에 내려감)
VAPID_PRIVATE_KEY=      # 같은 명령의 비공개키(절대 공개 금지)
VAPID_SUBJECT=          # mailto:운영담당@기관.go.kr
# 웹(Vercel) 접속 제어 — apps/web/lib/auth.ts
SITE_ACCESS_CODE=       # 일반 이용자 접속 코드(비우면 누구나)
ADMIN_ACCESS_CODE=      # 관리자 코드(데이터·API, 검증·소개)
AUTH_SECRET=            # 쿠키 서명용 임의의 긴 문자열
GOOGLE_CLIENT_ID=       # 구글 로그인 OAuth 클라이언트 ID(있으면 로그인 필요)
GOOGLE_CLIENT_SECRET=   # 구글 OAuth 클라이언트 보안 비밀
ALLOWED_EMAILS=         # 구글 로그인 허용(쉼표, "@도메인"=도메인 전체, 비우면 구글 계정 누구나)
ADMIN_EMAILS=           # 구글 로그인 관리자 이메일(쉼표)
KAKAO_CLIENT_ID=        # 카카오 로그인 REST API 키(회원번호만 받음)
KAKAO_CLIENT_SECRET=    # 카카오 Client Secret(콘솔에서 사용 설정한 경우만)
KAKAO_ADMIN_IDS=        # 카카오 관리자 회원번호(쉼표)
KAKAO_ALLOWED_IDS=      # 카카오 허용 회원번호(쉼표, 비우면 누구나)
NAVER_CLIENT_ID=        # 네이버 로그인 Client ID
NAVER_CLIENT_SECRET=    # 네이버 로그인 Client Secret
